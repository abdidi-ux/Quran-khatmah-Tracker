rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /quranTrackers/main {
      allow read: if true;
      allow create, update: if
        request.resource.data.keys().hasOnly([
          'dateKey', 'completed', 'khatmahCount', 'completedForDate'
        ]) &&
        request.resource.data.dateKey is string &&
        request.resource.data.completed is map &&
        request.resource.data.khatmahCount is int &&
        request.resource.data.khatmahCount >= 0 &&
        request.resource.data.completedForDate is bool;
      allow delete: if false;
    }
  }
}
